{
  "name": "Lychee",
  "package": "cloud.lazycat.app.lychee",
  "description": "图片管理工具",
  "homepage": "https://lycheeorg.dev",
  "author": "lychee",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "lychee",
  "version": "6.4.2",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "lychee_80_80": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_linuxserver_lychee_6.4.2": {
    "originalImage": "linuxserver/lychee:6.4.2",
    "pushTarget": "none"
  },
  "lychee_volume_/config_action": "emptyDir",
  "lychee_volume_/config_location": "app_data",
  "lychee_volume_/pictures_action": "emptyDir",
  "lychee_volume_/pictures_location": "app_data"
}
